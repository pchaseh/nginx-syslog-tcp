+static ssize_t
+ngx_syslog_send_queued(ngx_syslog_peer_t *peer, u_char *buf, size_t len)
+{
+    if (ngx_syslog_append(peer, buf, len) != NGX_OK) {
+        return NGX_ERROR;
+    }
+
+    if (peer->connection == NULL) {
+
+        /*
+         * connecting may reuse an idle connection whose handler
+         * is logging this message
+         */
+
+        ngx_post_event(peer->event, &ngx_posted_events);
+        return len;
+    }
+
+    if (peer->connection->write->ready) {
+        if (ngx_syslog_flush(peer) != NGX_OK) {
+            return NGX_ERROR;
+        }
+    }
+
+    return len;
+}
+
+
+static ngx_int_t
+ngx_syslog_append(ngx_syslog_peer_t *peer, u_char *buf, size_t len)
+{
+    ngx_buf_t  *b;
+
+    b = peer->buffer;
+
+    if (b == NULL) {
+        b = ngx_create_temp_buf(peer->pool, NGX_SYSLOG_BUFFER_SIZE);
+        if (b == NULL) {
+            return NGX_ERROR;
+        }
+
+        peer->buffer = b;
+    }
+
+    if ((size_t) (b->end - b->last) < NGX_SIZE_T_LEN + 1 + len) {
+        b->last = ngx_movemem(b->start, b->pos, b->last - b->pos);
+        b->pos = b->start;
+
+        if ((size_t) (b->end - b->last) < NGX_SIZE_T_LEN + 1 + len) {
+            return NGX_ERROR;
+        }
+    }
+
+    /* RFC 6587 octet counting */
+
+    b->last = ngx_sprintf(b->last, "%uz ", len);
+    b->last = ngx_cpymem(b->last, buf, len);
+
+    return NGX_OK;
+}
+
+
+static void
+ngx_syslog_connect_handler(ngx_event_t *ev)
+{
+    ngx_syslog_peer_t  *peer;
+
+    peer = ev->data;
+
+    /* errors logged here may be written to this peer by ngx_syslog_writer() */
+    peer->busy = 1;
+
+    if (ngx_syslog_connect(peer) != NGX_OK) {
+        ngx_syslog_close(peer);
+
+    } else if (peer->connection->write->ready) {
+        (void) ngx_syslog_flush(peer);
+    }
+
+    peer->busy = 0;
+}
+
+
+static ngx_int_t
+ngx_syslog_connect(ngx_syslog_peer_t *peer)
+{
+    ngx_int_t               rc;
+    ngx_connection_t       *c;
+    ngx_peer_connection_t   pc;
+
+    ngx_memzero(&pc, sizeof(ngx_peer_connection_t));
+
+    pc.sockaddr = peer->server.sockaddr;
+    pc.socklen = peer->server.socklen;
+    pc.name = &peer->server.name;
+    pc.get = ngx_event_get_peer;
+    pc.log = &peer->log;
+    pc.log_error = NGX_ERROR_ERR;
+
+    rc = ngx_event_connect_peer(&pc);
+
+    if (rc != NGX_OK && rc != NGX_AGAIN) {
+        return NGX_ERROR;
+    }
+
+    c = pc.connection;
+
+    c->data = peer;
+
+    c->read->handler = ngx_syslog_read_handler;
+    c->write->handler = ngx_syslog_write_handler;
+
+    c->read->syslog = 1;
+
+    peer->connection = c;
+
+    return NGX_OK;
+}
+
+
+static ngx_int_t
+ngx_syslog_flush(ngx_syslog_peer_t *peer)
+{
+    ssize_t            n;
+    ngx_buf_t         *b;
+    ngx_connection_t  *c;
+
+    c = peer->connection;
+    b = peer->buffer;
+
+    while (b->pos < b->last) {
+        n = c->send(c, b->pos, b->last - b->pos);
+
+        if (n == NGX_AGAIN) {
+            break;
+        }
+
+        if (n == NGX_ERROR) {
+            ngx_syslog_close(peer);
+            return NGX_ERROR;
+        }
+
+        b->pos += n;
+    }
+
+    if (b->pos == b->last) {
+        b->pos = b->start;
+        b->last = b->start;
+    }
+
+    if (ngx_handle_write_event(c->write, 0) != NGX_OK) {
+        ngx_syslog_close(peer);
+        return NGX_ERROR;
+    }
+
+    return NGX_OK;
+}
+
+
+static void
+ngx_syslog_read_handler(ngx_event_t *rev)
+{
+    u_char              buf[64];
+    ssize_t             n;
+    ngx_connection_t   *c;
+    ngx_syslog_peer_t  *peer;
+
+    c = rev->data;
+    peer = c->data;
+
+    /* errors logged here may be written to this peer by ngx_syslog_writer() */
+    peer->busy = 1;
+
+    for ( ;; ) {
+        n = c->recv(c, buf, sizeof(buf));
+
+        if (n == NGX_AGAIN) {
+            break;
+        }
+
+        if (n == 0) {
+            ngx_log_error(NGX_LOG_ERR, c->log, 0,
+                          "syslog server closed connection");
+        }
+
+        if (n == 0 || n == NGX_ERROR) {
+            ngx_syslog_close(peer);
+            goto done;
+        }
+    }
+
+    if (ngx_handle_read_event(rev, 0) != NGX_OK) {
+        ngx_syslog_close(peer);
+    }
+
+done:
+
+    peer->busy = 0;
+}
+
+
+static void
+ngx_syslog_write_handler(ngx_event_t *wev)
+{
+    ngx_connection_t   *c;
+    ngx_syslog_peer_t  *peer;
+
+    c = wev->data;
+    peer = c->data;
+
+    /* errors logged here may be written to this peer by ngx_syslog_writer() */
+    peer->busy = 1;
+
+    (void) ngx_syslog_flush(peer);
+
+    peer->busy = 0;
+}
+
+
+static void
+ngx_syslog_close(ngx_syslog_peer_t *peer)
+{
+    if (peer->buffer->pos < peer->buffer->last) {
+        ngx_log_error(NGX_LOG_ERR, &peer->log, 0,
+                      "syslog discarded %uz bytes of buffered messages",
+                      (size_t) (peer->buffer->last - peer->buffer->pos));
+    }
+
+    if (peer->connection) {
+        ngx_close_connection(peer->connection);
+        peer->connection = NULL;
+    }
+
+    peer->buffer->pos = peer->buffer->start;
+    peer->buffer->last = peer->buffer->start;
+}
+
+
 static void
 ngx_syslog_cleanup(void *data)
 {
@@ -376,6 +721,18 @@ ngx_syslog_cleanup(void *data)
     /* prevents further use of this peer */
     peer->busy = 1;
 
+    if (peer->event && peer->event->posted) {
+        ngx_delete_posted_event(peer->event);
+    }
+
+    if (peer->connection) {
+        (void) ngx_syslog_flush(peer);
+    }
+
+    if (peer->buffer) {
+        ngx_syslog_close(peer);
+    }
+
     if (peer->conn.fd == (ngx_socket_t) -1) {
         return;
     }
